  "entries": [
    {
      "id": "kb_hvac_cooling_decline",
      "system": "hvac",
      "title": "制冷量逐渐下降，出风勉强凉但不冷",
      "symptoms": [
        "刚开机还凉，运行一段时间后出风温度回升",
        "客室温度降不到设定值",
        "压缩机一直运行但效果越来越差"
      ],
      "keywords": [
        "制冷量下降",
        "越来越不凉",
        "出风温回升",
        "降不到设定",
        "效果差"
      ],
      "likely_causes": [
        {
          "text": "冷凝器散热能力下降，冷凝压力升高",
          "weight": 1.0
        },
        {
          "text": "制冷剂缓慢泄漏，系统充注量不足",
          "weight": 0.8
        },
        {
          "text": "蒸发器滤网或翅片脏堵，换热变差",
          "weight": 0.7
        },
        {
          "text": "膨胀阀调节性能下降",
          "weight": 0.5
        }
      ],
      "checks": [
        {
          "order": 1,
          "action": "测量送风温度与回风温度差",
          "expect": "温差达到标称值"
        },
        {
          "order": 2,
          "action": "测量系统高压与低压",
          "expect": "均在标称范围"
        },
        {
          "order": 3,
          "action": "检查冷凝器与蒸发器清洁度",
          "expect": "翅片通透、无积尘"
        },
        {
          "order": 4,
          "action": "检查视液镜与管路接头",
          "expect": "无气泡、无油迹"
        }
      ],
      "escalation": "清洁与压力检查均正常仍制冷不足时，按制冷剂充注量或压缩机效率检测处理，禁止盲目补充制冷剂。",
      "safety": "制冷系统作业佩戴护目镜与防冻手套，防止制冷剂冻伤。",
      "sources": [
        "K-05"
      ],
      "source_links": [
        "http://www.chinaqking.com/yc/2020/2144756.html"
      ]
    },
