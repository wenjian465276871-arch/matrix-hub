    {
      "id": "kb_door_regulator_low",
      "system": "door",
      "title": "总风压力正常，本门减压阀输出偏低",
      "symptoms": [
        "总风表压力正常，本门气动锁动作明显无力",
        "同一列车其它门正常，只有这一门气压低",
        "门能关到位但锁不住"
      ],
      "keywords": [
        "减压阀输出低",
        "本门气压低",
        "总风正常",
        "锁不住",
        "调压阀"
      ],
      "likely_causes": [
        {
          "text": "减压阀调压弹簧疲劳，输出压力下降",
          "weight": 1.0
        },
        {
          "text": "减压阀阀芯被杂质卡住",
          "weight": 0.8
        },
        {
          "text": "减压阀后管路漏气，静态压力看着正常",
          "weight": 0.65
        },
        {
          "text": "减压阀选型或设定值错误",
          "weight": 0.4
        }
      ],
      "checks": [
        {
          "order": 1,
          "action": "在减压阀出口接表测量静态与动作时压力",
          "expect": "静态与动作时均不低于标称下限"
        },
        {
          "order": 2,
          "action": "关闭下游截断塞门观察压力是否保持",
          "expect": "保压 5 分钟压降不超过 0.02MPa"
        },
        {
          "order": 3,
          "action": "拆检减压阀滤芯与阀芯",
          "expect": "无杂质、阀芯活动自如"
        },
        {
          "order": 4,
          "action": "按标称值重新调整输出压力",
          "expect": "调整后压力稳定"
        }
      ],
      "escalation": "调压后压力仍不稳或阀芯卡死时更换减压阀，禁止把输出压力调高到超过下游额定值。",
      "safety": "调整气路前确认门区无人，泄压后再拆接头。",
      "sources": [
        "K-04"
      ],
      "source_links": [
        "https://edl.csrzic.com/zh/article/doi/10.13890/j.issn.1000-128x.2019.04.033/"
      ]
    },
