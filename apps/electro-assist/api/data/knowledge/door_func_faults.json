    {
      "id": "kb_door_anti_pinch_force",
      "system": "door",
      "title": "防夹力超差，夹到人不能及时弹开",
      "symptoms": [
        "用测力计测防夹力明显高于标称上限",
        "夹到手臂后门还在继续关",
        "门关闭末段速度偏快"
      ],
      "keywords": [
        "防夹力大",
        "夹得疼",
        "很疼才弹",
        "防夹力超差",
        "夹持力大"
      ],
      "likely_causes": [
        {
          "text": "防夹力参数设置偏大",
          "weight": 1.0
        },
        {
          "text": "压力开关或胶条灵敏度下降",
          "weight": 0.75
        },
        {
          "text": "关门末段速度过快",
          "weight": 0.6
        },
        {
          "text": "门扇密封条过硬",
          "weight": 0.45
        }
      ],
      "checks": [
        {
          "order": 1,
          "action": "用测力计按标定点测防夹力",
          "expect": "防夹力在标称范围内"
        },
        {
          "order": 2,
          "action": "核对门控器防夹参数",
          "expect": "参数与基线一致"
        },
        {
          "order": 3,
          "action": "检查压力开关或胶条触发",
          "expect": "受压即触发"
        },
        {
          "order": 4,
          "action": "调整参数后重复测量",
          "expect": "三次测量均在范围内"
        }
      ],
      "escalation": "参数调整后仍超差时更换压力开关或胶条，禁止把防夹功能关闭。",
      "safety": "防夹试验必须用标准试验块或测力计，严禁用手直接试。",
      "sources": [
        "K-04"
      ],
      "source_links": [
        "https://edl.csrzic.com/zh/article/doi/10.13890/j.issn.1000-128x.2019.04.033/"
      ]
    },
