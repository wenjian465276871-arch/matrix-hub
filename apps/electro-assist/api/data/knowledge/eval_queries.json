    { "query": "出风口结露往下滴水，滴到座椅上", "expect": "kb_hvac_outlet_condensate", "note": "新增：出风口结露" },
    { "query": "废排逆变器不启动，废排风机完全不转", "expect": "kb_hvac_exhaust_inverter", "note": "新增：废排逆变器" },
    { "query": "电加热器不热，冬天客室温度上不去", "expect": "kb_hvac_heater_no_heat", "note": "新增：电加热不热" },
    { "query": "升弓电磁阀没有动作声，手动按阀芯能升弓", "expect": "kb_pantograph_solenoid", "note": "新增：升弓电磁阀" },
    { "query": "升弓气囊漏气，升弓无力还升不到顶", "expect": "kb_pantograph_bellow_leak", "note": "新增：气囊漏气" },
    { "query": "降弓砸顶，弓头砸到底架咣一声", "expect": "kb_pantograph_lower_slam", "note": "新增：降弓砸顶" },
    { "query": "ADD 上气室连接管路漏气，运行中频繁自动降弓", "expect": "kb_pantograph_add_chamber", "note": "新增：ADD 上气室漏" },
    { "query": "碳滑板边缘掉块，接触面不平", "expect": "kb_pantograph_strip_chip", "note": "新增：滑板掉块" },
