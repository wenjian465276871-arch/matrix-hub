    { "query": "静态接触压力偏低，运行中离线火花多", "expect": "kb_pantograph_static_low", "note": "新增：静态压力低" },
    { "query": "支持绝缘子表面有裂纹，绝缘电阻低", "expect": "kb_pantograph_insulator_crack", "note": "新增：绝缘子裂纹" },

    { "query": "制动缸压力不足，刹车软", "expect": "kb_brake_cylinder_leak", "note": "扩系统：制动缸漏气（原「未收录」用例转正向）" },
    { "query": "闸瓦间隙越来越大，制动缸行程变长", "expect": "kb_brake_slack_adjuster", "note": "扩系统：间隙调整器失效" },
    { "query": "雨刷不动，风挡玻璃刮不干净", "expect": "kb_wiper_no_action", "note": "扩系统：雨刷完全不动作（原「未收录」用例转正向）" },
    { "query": "雨刮电机有嗡嗡声但刮臂不动", "expect": "kb_wiper_motor_hum", "note": "扩系统：电机响刮臂不动" }
