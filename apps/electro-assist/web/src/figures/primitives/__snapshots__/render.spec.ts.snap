    <title data-v-45b22d7a="">对照表，3 行</title>
    <rect data-v-45b22d7a="" x="0" y="0" width="340" height="26" class="fig-track"></rect>
    <g data-v-45b22d7a=""><text data-v-45b22d7a="" x="6" y="17" font-size="11" class="fig-ink" font-weight="600">项目</text>
      <!--v-if-->
    </g>
    <g data-v-45b22d7a=""><text data-v-45b22d7a="" x="157.95530726256982" y="17" font-size="11" class="fig-ink" font-weight="600">标准</text>
      <line data-v-45b22d7a="" x1="151.95530726256982" y1="0" x2="151.95530726256982" y2="103" stroke-width="1" class="fig-stroke-line"></line>
    </g>
    <g data-v-45b22d7a="">
      <rect data-v-45b22d7a="" x="0" y="26" width="340" height="25" class="fig-surface"></rect>
      <line data-v-45b22d7a="" x1="0" y1="51" x2="340" y2="51" stroke-width="1" class="fig-stroke-line"></line><text data-v-45b22d7a="" font-size="11" class="fig-ink">
        <tspan data-v-45b22d7a="" x="6" y="41">门扇间隙</tspan>
      </text><text data-v-45b22d7a="" font-size="11" class="fig-ink">
        <tspan data-v-45b22d7a="" x="157.95530726256982" y="41">2.0–5.0mm</tspan>
      </text>
    </g>
    <g data-v-45b22d7a="">
      <rect data-v-45b22d7a="" x="0" y="51" width="340" height="25" class="fig-primary-soft"></rect>
      <line data-v-45b22d7a="" x1="0" y1="76" x2="340" y2="76" stroke-width="1" class="fig-stroke-line"></line><text data-v-45b22d7a="" font-size="11" class="fig-ink">
        <tspan data-v-45b22d7a="" x="6" y="66">锁闭信号</tspan>
      </text><text data-v-45b22d7a="" font-size="11" class="fig-ink">
        <tspan data-v-45b22d7a="" x="157.95530726256982" y="66">100% 关闭</tspan>
      </text>
    </g>
    <g data-v-45b22d7a="">
      <rect data-v-45b22d7a="" x="0" y="76" width="340" height="25" class="fig-surface"></rect>
      <line data-v-45b22d7a="" x1="0" y1="101" x2="340" y2="101" stroke-width="1" class="fig-stroke-line"></line><text data-v-45b22d7a="" font-size="11" class="fig-ink">
        <tspan data-v-45b22d7a="" x="6" y="91">关门到位</tspan>
      </text><text data-v-45b22d7a="" font-size="11" class="fig-ink">
        <tspan data-v-45b22d7a="" x="157.95530726256982" y="91">无回弹</tspan>
      </text>
    </g>
    <rect data-v-45b22d7a="" x="0.5" y="0.5" width="339" height="102" fill="none" stroke-width="1" class="fig-stroke-line"></rect>
  </svg>
  <!-- 窄屏（<360px）堆叠：SVG 里 11px 的字缩到 320 宽只剩 9px，横着排谁也读不了。
         用真表格而不是 div：读屏仍按表格播报，视觉上再拆成「表头: 值」。
         首列当行标题（th），其余 td 用 data-label 出标签。 -->
  <table data-v-45b22d7a="" class="fig-table__stack">
    <!-- 打印时这张表的 thead 会在每页顶部重复（计划 §12.6）。
           屏幕上的窄屏堆叠模式把它藏起来：那时每行自带 data-label，再顶一行表头是重复信息。 -->
    <thead data-v-45b22d7a="">
      <tr data-v-45b22d7a="">
        <th data-v-45b22d7a="" scope="col">项目</th>
        <th data-v-45b22d7a="" scope="col">标准</th>
      </tr>
    </thead>
    <tbody data-v-45b22d7a="">
      <tr data-v-45b22d7a="">
