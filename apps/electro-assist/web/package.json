{
  "name": "electro-assist-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check:inline": "node scripts/check-inline.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:a11y": "node scripts/axe.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
