# 统一入口：TLS、安全头、静态资源、API 反代
# 域名通过环境变量注入（compose 里传 SITE_DOMAIN），仓库内不写死
{
	email {$ACME_EMAIL:admin@example.com}
	admin off
}

http://{$SITE_DOMAIN:localhost}, http://www.{$SITE_DOMAIN:localhost} {
	redir https://{host}{uri} permanent
}

{$SITE_DOMAIN:localhost}, www.{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# 全局请求体上限 2MB；上传路由单独放宽（见下）
	request_body {
		max_size 2MB
	}

	# ---- 健康检查：聚合在 electro API 内 ----
	handle /healthz {
		reverse_proxy 127.0.0.1:8001
	}

	# ---- API：仅 electro（news 已下架，见 ADR-0002）----
	# B 排查支持流式（决策 #36）：`stream=1` 时按 recall → rerank → done 三帧推送。
	# SSE 必须关掉响应缓冲（`flush_interval -1`），否则三帧会堆到最后一起吐，
	# 前端看到的仍然是"等 3 秒然后全部出现"；`read_timeout` 给到 300s 是因为
	# 重排那一步是模型调用，默认超时会把它掐断。
	# 非流式请求走同一个后端，只是多了一次不缓冲——对一次性 JSON 无影响。
	handle /api/electro/diagnose* {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
			transport http {
				read_timeout 300s
			}
		}
	}

	handle /api/electro/uploads* {
		request_body {
			max_size 6MB
		}
		reverse_proxy 127.0.0.1:8001
	}

	handle /api/electro/* {
		reverse_proxy 127.0.0.1:8001
	}

	# 明确的 404，避免落到 SPA 回退后返回 200
	handle /api/* {
		respond 404
	}

	# ---- 历史粒子实验已归档（ADR-0003），不再提供路由 ----
	handle /apps/particle-system/* {
		respond 404
	}

	# ---- 静态：电气调试助手（Vue SPA）----
	handle_path /apps/electro-assist/* {
		# 带内容 hash 的产物：一年缓存，且**缺文件必须 404**。
		# 不能走下面的 SPA 回退：2026-11-02 线上真实故障——页面停在发版前的旧 bundle，
		# 任务成功要跳详情页时请求已删除的 `GuideView-<旧hash>.js`，回退返回 index.html(200)，
		# 浏览器拿 HTML 当 JS 解析必然失败，`router.push` 抛错被轮询的 catch 吞掉，
		# 前端表现成"一直转圈到 90 秒超时"，而服务端 29 秒就生成完了。
		handle /assets/* {
			root * /srv/static/electro
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# 其余（HTML 与 SPA 路由）：每次回源。`no-cache` 允许 304，省流量但不给旧页面。
		# 之前把 `header /index.html` 写在 try_files 外面是无效的：直接访问 `/`
		# 时请求路径不是 `/index.html`，`try_files` 只是内部改写，匹配不到。
		handle {
			root * /srv/static/electro
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	# ---- 门户 ----
	handle {
		root * /srv/static/portal
		try_files {path} {path}/ /index.html
		file_server
	}

	# 访问日志落文件、按大小滚动，滚出的文件保留 14 天（计划 §11.3.3）。
	#
	# 2026-11-03 改：此前 `output stdout` 交给 Docker 的 10MB×3 轮转，保留时长
	# 由流量决定——低流量能存几个月，流量涨十倍就只剩几天，"14 天"只是碰巧成立。
	#
	# 口径（查 Caddy 2.8.4 源码确认）：`roll_keep_for` 是时长字符串，按天向上取整；
	# `roll_keep_for 336h` = 14 天。时间删除发生在**滚动时**。
	#
	# 2026-11-08 修：`roll_size` 10MiB → **2MiB**。实测流量约 1.3MB/天，10MiB 要 8 天才滚
	# 一次，滚出来的文件再留 14 天，实际寿命可达 22 天；而零流量站点永远不滚，"14 天"
	# 等于不存在。改 2MiB 后约 1.5 天滚一次，寿命收敛到 ~15 天。
	# 零流量那种极端情况由 `services/retention.py` 的 `prune_logs()` 兜底：
	# mtime 超过 14 天（证明 14 天内没有写入）就清空当前文件，见该函数注释。
	log {
		output file /srv/app_data/logs/access.log {
			roll_size 2MiB
			roll_keep 20
			roll_keep_for 336h
		}
		format console
	}
}
