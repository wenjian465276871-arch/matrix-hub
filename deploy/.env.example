# 服务器侧 .env 模板
# 用法：复制为 /opt/matrix-hub/.env，chmod 600。真实值不入库、不出现在文档与日志里。
# 注意：deploy.sh 会从本文件读取 IMAGE / TAG / SITE_DOMAIN / ACME_EMAIL，缺一项即失败。

IMAGE=crpi-xxxxxxxxxxxxxxxx.cn-shenzhen.personal.cr.aliyuncs.com/matrix-hub/matrix-hub
TAG=<git-sha>
SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
APP_ENV=prod

# 模型调用（不配也能起站：只读页面正常，/generate 会返回 503/auth）
DEEPSEEK_API_KEY=<deepseek-api-key>

# 上传限流（进程内滑窗，单 worker 前提下有效；见 apps/electro-assist/api/ratelimit.py）
UPLOAD_RATE_PER_HOUR=6
UPLOAD_RATE_PER_DAY=20
UPLOAD_SITE_PER_DAY=200

# 生成配额与预算（2026-10-19 起生效；见 services/quota.py）
# 访客配额不统计 failed/timeout；全站预算统计所有实际 token 消耗。
GENERATE_PER_HOUR=2
GENERATE_PER_DAY=10
GENERATE_DAILY_BUDGET_MICROS=3000000
GENERATE_ESTIMATE_MICROS=30000

# 图片切图限流（2026-10-21；切图是重 CPU + 写盘操作，单独设闸）
SLICE_PER_HOUR=20
SLICE_PER_DAY=100
SLICE_SITE_PER_DAY=500
MAX_SLICES_PER_ASSET=5

# 访客写入口令（可选）。不配置则口令通道整体关闭（验证接口 503）。
# 口令只豁免「每 IP」配额，全站日预算仍然生效。令牌有效期 12 小时。
# 生成真实口令时用随机串（例如 openssl rand -base64 24），不要用示例值。
# ELECTRO_PASSCODE=<random-passcode>
PASSCODE_PER_HOUR=10
PASSCODE_PER_DAY=50
PASSCODE_SITE_PER_DAY=500

# 健康检查磁盘阈值：剩余空间低于该比例时 /healthz 返回 degraded（默认 0.10）
HEALTHZ_MIN_FREE_RATIO=0.10

# A1 会话创建限流（每次作业一次写入；进程内滑窗）
SESSION_PER_HOUR=10

# B 排查（检索式，不调用模型；限流只为避免刷日志）
# MIN_SCORE 越高越容易回"未覆盖"；现场宁可说没查到，也不给错的排查链。
DIAGNOSE_PER_HOUR=60
DIAGNOSE_PER_DAY=300
DIAGNOSE_SITE_PER_DAY=3000
DIAGNOSE_MIN_SCORE=3.0
