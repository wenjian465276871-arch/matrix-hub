# 依赖与虚拟环境
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 运行数据（本地跑起来会生成 SQLite 与上传资产，绝不入库）
app_data/
*.db
*.db-wal
*.db-shm

# 备份目录（服务器本地生成，绝不入库）
backups/

# 构建产物
dist/
dist-ssr/
build/
coverage/
.vite/

# 密钥与环境（.env.example 例外，需入库）
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志与临时
*.log
logs/
tmp/
.tmp/

# Playwright 产物（2026-10-21）
test-results/
playwright-report/
blob-report/
.playwright/

# 注意：锁文件（uv.lock / package-lock.json）必须入库，不要忽略
